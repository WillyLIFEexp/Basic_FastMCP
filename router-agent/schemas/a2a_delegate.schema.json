{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2A Delegate Envelope",
  "type": "object",
  "properties": {
    "type": { "const": "delegate" },
    "reason": { "type": "string", "minLength": 1 },
    "to_agent": { "enum": ["sql-helper", "english-tutor"] },
    "payload": { "type": "object" },
    "parent_task": { "type": "string" }
  },
  "required": ["type", "reason", "to_agent", "payload", "parent_task"],
  "additionalProperties": false
}
